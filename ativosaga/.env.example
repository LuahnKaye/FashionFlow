# Modelo de variáveis de ambiente para o AtivoSAGA
# Copie este arquivo para .env e preencha com suas credenciais

# --- BANCO DE DADOS ---
POSTGRES_USER=usuario_loja
POSTGRES_PASSWORD=insira_sua_senha_aqui
POSTGRES_DB=ativosaga

# --- RABBITMQ ---
RABBITMQ_DEFAULT_USER=convidado
RABBITMQ_DEFAULT_PASS=convidado

# --- STRIPE (OBTENHA EM DASHBOARD.STRIPE.COM) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- CONFIGURAÇÕES DE REDE ---
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@banco:5432/${POSTGRES_DB}
RABBITMQ_HOST=rabbitmq
